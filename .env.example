# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values for the platforms you want
# to enable. Never commit your real .env file.
# ---------------------------------------------------------------------------

# General
# Set DEMO_MODE=true to simulate successful posts to every platform.
# Useful for reviewing the API without configuring real credentials.
DEMO_MODE=false
REQUEST_TIMEOUT=15.0

# --- Bluesky ---------------------------------------------------------------
# Settings -> App Passwords (NOT your main account password)
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- DEV Community (dev.to) ------------------------------------------------
# Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=your_devto_api_key

# --- Mastodon --------------------------------------------------------------
# Any instance, e.g. https://mastodon.social or https://hachyderm.io
# Settings -> Development -> New application (scope: write:statuses)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# --- Telegram --------------------------------------------------------------
# 1. Talk to @BotFather -> /newbot  (bot token)
# 2. Add the bot as an admin of your public channel and use "@channelname"
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=@your_public_channel

# --- Discord ---------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx