# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment / secrets  (never commit real credentials)
.env
.env.*
!.env.example

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs and generated demo artifacts (keep captured samples, ignore runtime output)
logs/*
!logs/.gitkeep
!logs/*.json

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/